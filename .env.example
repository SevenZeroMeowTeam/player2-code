# ======================================================
# Player2 服务端全局环境变量 (docker-compose 使用)
# ======================================================

# ---- DeepSeek R1 AI 网关 ----
# 方案 A（默认）：使用 ai.bbsmc.org.cn 网关（自签证书，已内置 TLS 兼容）
# 方案 B（官方）：使用 DeepSeek 官方 API，取消注释下方三行
#   AI_API_URL=https://api.deepseek.com/v1
#   AI_API_KEY=sk-your-real-deepseek-api-key
#   AI_MODEL=deepseek-reasoner
AI_API_URL=https://ai.bbsmc.org.cn/v1
AI_API_KEY=sk-your-real-deepseek-r1-api-key-here

# 推理模型名（决策用）
AI_MODEL=deepseek-reasoner
# 聊天模型名（可选，不填则复用 AI_MODEL）
AI_CHAT_MODEL=deepseek-chat

# ---- Ollama 本地模型（docker-compose 自动拉取）----
# 可选模型：deepseek-r1:1.5b（小/快） / deepseek-r1:7b（默认） / deepseek-r1:8b / deepseek-r1:14b
OLLAMA_MODEL=deepseek-r1:7b

# ---- JWT ----
JWT_SECRET=please_change_this_to_a_random_string_with_at_least_32_chars

# ---- 域名（给 certbot/注释用）----
DOMAIN=player.qlm.org.cn

# ======================================================
# 官方 Player2 API 兼容性说明
# ======================================================
# backend/src/routes/npcs.js 已对齐 elefant-ai/player2-sdk-ts 契约：
#   POST /npcs/spawn              创建 NPC（返回 text/plain UUID）
#   GET  /npcs                    列出当前用户 NPC（扩展端点）
#   GET  /npcs/responses          SSE/newline JSON 响应流
#   POST /npcs/:npcId/chat        发送消息触发 LLM 决策
#   POST /npcs/:npcId/kill        删除 NPC
#   GET  /npcs/:npcId/history     对话历史
#   GET  /joules                  自托管无限余额（999999）
#   GET  /selected_characters     角色库（暂返回空）
#   GET  /tts/voices              TTS 语音（暂返回空）
#
# 鉴权：所有 /npcs、/joules、/selected_characters、/tts 路径强制 JWT
#   - Header：Authorization: Bearer <token>
#   - Query：?token=<token>  （EventSource 无法设 header 时使用）
# 登录：POST /api/v1/auth/login  { username, password } → { token }
#
# 上面的 AI_API_URL / AI_API_KEY / AI_MODEL 同样驱动 NPC 对话的 LLM 调用，
# 不需要单独为 NPC 配置 AI 凭据。
