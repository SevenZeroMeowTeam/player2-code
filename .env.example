# ======================================================
# Player2 服务端全局环境变量 (docker-compose 使用)
# ======================================================

# ---- DeepSeek R1 (ai.bbsmc.org.cn) ----
# 如果 ai.bbsmc.org.cn 是自托管的 DeepSeek R1 兼容 OpenAI 协议的网关
# 注意：ai.bbsmc.org.cn 使用自签证书，docker-compose 已内置 NODE_TLS_REJECT_UNAUTHORIZED=0
AI_API_URL=https://ai.bbsmc.org.cn/v1
AI_API_KEY=sk-your-real-deepseek-r1-api-key-here

# 推理模型名（决策用）
AI_MODEL=deepseek-reasoner
# 聊天模型名（可选，不填则复用 AI_MODEL）
AI_CHAT_MODEL=deepseek-chat

# ---- JWT ----
JWT_SECRET=please_change_this_to_a_random_string_with_at_least_32_chars

# ---- 域名（给 certbot/注释用）----
DOMAIN=player.qlm.org.cn
