PORT=8080
NODE_ENV=production

# ============ DeepSeek R1 (ai.bbsmc.org.cn) ============
# 如果 ai.bbsmc.org.cn 是兼容 OpenAI 协议的 DeepSeek R1 中转：
AI_API_URL=https://ai.bbsmc.org.cn/v1
AI_API_KEY=sk-your-deepseek-r1-api-key-here

# 决策模型（DeepSeek R1 推理模型）: deepseek-reasoner 或 deepseek-chat 或自定义部署名
AI_MODEL=deepseek-reasoner

# 聊天模型（可选，单独指定；不填则复用 AI_MODEL）
# AI_CHAT_MODEL=deepseek-chat

# ============ JWT & 业务 ============
JWT_SECRET=please_change_this_to_a_32_char_random_string
WS_HEARTBEAT_INTERVAL=30000
MAX_AI_PLAYERS_PER_USER=10
