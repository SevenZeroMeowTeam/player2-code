# ========== Player2 Bridge (EXE 桥梁客户端) ==========
# 部署域名
BACKEND_WS=wss://player.qlm.org.cn
# 登录后获得的 JWT token，或访问 /api/v1/auth/login 获取
TOKEN=your_jwt_token_here

# ========== 要加入的 Minecraft 服务器 ==========
MC_SERVER=127.0.0.1
MC_PORT=25565
MC_VERSION=1.20.1
PLAYER_NAME=AIPlayer_01

# 感知上报间隔（毫秒）。DeepSeek R1 推理较久，建议 1500~3000
PERCEPTION_INTERVAL_MS=2000
VIEW_DISTANCE=4

# 如果用 Node.js 直接启动 Bridge（非 EXE），可在此覆写后端默认 AI 模型
# AI_MODEL=deepseek-reasoner
